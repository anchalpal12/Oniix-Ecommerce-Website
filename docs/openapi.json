{
  "openapi": "3.0.3",
  "info": {
    "title": "Onix E-commerce API",
    "version": "1.0.0",
    "description": "REST API for Onix smart mining glasses storefront and admin."
  },
  "servers": [{ "url": "/api", "description": "Same origin" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/users/signup": {
      "post": {
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List products (paginated)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } }
        ]
      }
    },
    "/orders/place-order": {
      "post": {
        "summary": "Place order (COD/UPI/simulated card)",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": { "type": "string" }
          }
        ]
      }
    },
    "/orders/create-checkout-session": {
      "post": { "summary": "Create Stripe Checkout session" }
    },
    "/orders/stripe/complete": {
      "get": {
        "summary": "Complete order after Stripe redirect",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ]
      }
    },
    "/admin/dashboard": {
      "get": {
        "summary": "Admin dashboard KPIs",
        "security": [{ "bearerAuth": [] }]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
